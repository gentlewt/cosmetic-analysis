# 실제 값은 Git에서 제외되는 .env.local에만 입력합니다. 이 파일에는 값을 넣지 마세요.
# HTTPS 프로젝트 기본 URL (경로·쿼리·사용자명·비밀번호 제외)
VITE_SUPABASE_URL=
# 공개용 sb_publishable_... 또는 role=anon인 기존 공개 JWT만 허용합니다.
# VITE_ 값은 브라우저에 공개됩니다. service_role, sb_secret_, 비밀번호 금지.
VITE_SUPABASE_PUBLISHABLE_KEY=
# 설정해도 테이블 조회/쓰기/계정 로그인/로컬 데이터 이전은 활성화되지 않습니다.
